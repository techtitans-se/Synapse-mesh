<?xml version="1.0"?>
<robot name="synapse_amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= ARGUMENTS ================= -->
  <xacro:arg name="robot_name" default=""/>
  
  <xacro:property name="ns" value="$(arg robot_name)"/>
  <xacro:property name="tf_pref" value="${ns + '/' if ns != '' else ''}"/>

  <!-- ================= PROPERTIES ================= -->
  <xacro:property name="PI" value="3.1415926535897931"/>

  <!-- Chassis dimensions -->
  <xacro:property name="chassis_length" value="0.85"/>
  <xacro:property name="chassis_width" value="0.60"/>
  <xacro:property name="chassis_height" value="0.22"/>
  <xacro:property name="chassis_mass" value="45.0"/>

  <!-- Wheel dimensions -->
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_separation" value="0.52"/>
  <xacro:property name="wheel_mass" value="3.0"/>

  <!-- Caster dimensions -->
  <xacro:property name="caster_radius" value="0.035"/>
  <xacro:property name="caster_mass" value="0.8"/>
  <xacro:property name="caster_x_offset" value="0.32"/>
  <xacro:property name="caster_y_offset" value="0.22"/>

  <!-- Inertia macros -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (w*w + d*d)}" iyz="0.0"
               izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0.0"
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(2/5) * m * (r*r)}" ixy="0.0" ixz="0.0"
               iyy="${(2/5) * m * (r*r)}" iyz="0.0"
               izz="${(2/5) * m * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- ================= COLORS / MATERIALS ================= -->
  <material name="hazard_yellow">
    <color rgba="0.95 0.76 0.06 1.0"/>
  </material>
  <material name="dark_charcoal">
    <color rgba="0.15 0.17 0.20 1.0"/>
  </material>
  <material name="accent_blue">
    <color rgba="0.10 0.50 0.90 1.0"/>
  </material>
  <material name="black_rubber">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="emergency_red">
    <color rgba="0.90 0.15 0.15 1.0"/>
  </material>
  <material name="scanner_glass">
    <color rgba="0.10 0.85 0.95 0.8"/>
  </material>

  <!-- ================= BASE FOOTPRINT & BASE LINK ================= -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- Main lower chassis -->
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="hazard_yellow"/>
    </visual>
    <!-- Top payload plate -->
    <visual>
      <origin xyz="0 0 ${chassis_height + 0.005}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length * 0.96} ${chassis_width * 0.95} 0.01"/>
      </geometry>
      <material name="dark_charcoal"/>
    </visual>
    <!-- Protective perimeter bumper edge -->
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length + 0.03} ${chassis_width + 0.03} 0.06"/>
      </geometry>
      <material name="dark_charcoal"/>
    </visual>
    <!-- Front status indicator LED bar -->
    <visual>
      <origin xyz="${chassis_length/2 + 0.016} 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.005 ${chassis_width * 0.7} 0.02"/>
      </geometry>
      <material name="accent_blue"/>
    </visual>
    <!-- Rear status indicator LED bar -->
    <visual>
      <origin xyz="${-chassis_length/2 - 0.016} 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.005 ${chassis_width * 0.7} 0.02"/>
      </geometry>
      <material name="accent_blue"/>
    </visual>
    <!-- Emergency Stop 1 (Front Left) -->
    <visual>
      <origin xyz="${chassis_length/2 - 0.05} ${chassis_width/2 - 0.05} ${chassis_height + 0.02}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.025"/>
      </geometry>
      <material name="emergency_red"/>
    </visual>
    <!-- Emergency Stop 2 (Rear Right) -->
    <visual>
      <origin xyz="${-chassis_length/2 + 0.05} ${-chassis_width/2 + 0.05} ${chassis_height + 0.02}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.025"/>
      </geometry>
      <material name="emergency_red"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia m="${chassis_mass}" w="${chassis_width}" h="${chassis_length}" d="${chassis_height}"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <!-- ================= DRIVE WHEELS ================= -->
  <xacro:macro name="drive_wheel" params="prefix side y_offset">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black_rubber"/>
      </visual>
      <!-- Hubcap -->
      <visual>
        <origin xyz="0 ${y_offset * 0.01} 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 0.5}" length="${wheel_width + 0.002}"/>
        </geometry>
        <material name="dark_charcoal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${side * wheel_separation/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.2" friction="0.2"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" side="1" y_offset="1"/>
  <xacro:drive_wheel prefix="right" side="-1" y_offset="-1"/>

  <!-- ================= 4-CORNER CASTER SUPPORTS ================= -->
  <xacro:macro name="caster_ball" params="prefix x_sign y_sign">
    <link name="${prefix}_caster_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="dark_charcoal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_link"/>
      <!-- Wheel radius is 0.08, caster radius is 0.035 -> offset is -(0.08 - 0.035) = -0.045 -->
      <origin xyz="${x_sign * caster_x_offset} ${y_sign * caster_y_offset} ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${prefix}_caster_link">
      <material>Gazebo/Grey</material>
      <mu1>0.001</mu1>
      <mu2>0.001</mu2>
      <kp>1000000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:caster_ball prefix="front_left" x_sign="1" y_sign="1"/>
  <xacro:caster_ball prefix="front_right" x_sign="1" y_sign="-1"/>
  <xacro:caster_ball prefix="rear_left" x_sign="-1" y_sign="1"/>
  <xacro:caster_ball prefix="rear_right" x_sign="-1" y_sign="-1"/>

  <!-- ================= 360 LIDAR SENSOR ================= -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="dark_charcoal"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.03"/>
      </geometry>
      <material name="scanner_glass"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.5" r="0.05" h="0.06"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- Positioned on top deck forward of center for maximum line of sight -->
    <origin xyz="0.22 0 ${chassis_height + 0.04}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <material>Gazebo/DarkGrey</material>
    <sensor name="amr_lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <plugin name="amr_laser_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>$(arg robot_name)</namespace>
          <argument>~/out:=scan</argument>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>${tf_pref}lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ================= FRONT RGB-D / DEPTH CAMERA ================= -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.12 0.03"/>
      </geometry>
      <material name="dark_charcoal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.12 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.2" w="0.12" h="0.03" d="0.03"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_length/2 + 0.01} 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame for ROS camera conventions (Z forward, X right, Y down) -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
    <sensor name="amr_depth_camera" type="depth">
      <update_rate>10</update_rate>
      <camera>
        <horizontal_fov>1.25</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin name="amr_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>$(arg robot_name)</namespace>
          <remapping>image_raw:=camera/image_raw</remapping>
          <remapping>depth/image_raw:=camera/depth/image_raw</remapping>
          <remapping>camera_info:=camera/camera_info</remapping>
          <remapping>depth/camera_info:=camera/depth/camera_info</remapping>
          <remapping>points:=camera/points</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>${tf_pref}camera_optical_link</frame_name>
        <min_depth>0.1</min_depth>
        <max_depth>8.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ================= IMU SENSOR ================= -->
  <link name="imu_link">
    <xacro:box_inertia m="0.05" w="0.02" h="0.02" d="0.01"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="amr_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <plugin name="amr_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>$(arg robot_name)</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>${tf_pref}imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ================= DIFFERENTIAL DRIVE CONTROLLER PLUGIN ================= -->
  <gazebo>
    <plugin name="amr_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>$(arg robot_name)</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>

      <!-- Wheels -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- Kinematics -->
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>

      <!-- Limits -->
      <max_wheel_torque>60</max_wheel_torque>
      <max_wheel_acceleration>3.5</max_wheel_acceleration>

      <!-- Output -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

      <odometry_frame>${tf_pref}odom</odometry_frame>
      <robot_base_frame>${tf_pref}base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

</robot>
