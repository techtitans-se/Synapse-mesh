<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="cargo_box">
    <link name="box_body">
      <visual name="cardboard">
        <pose>0 0 0.175 0 0 0</pose>
        <geometry><box><size>0.50 0.40 0.35</size></box></geometry>
        <material>
          <ambient>0.62 0.46 0.28 1.0</ambient>
          <diffuse>0.74 0.55 0.34 1.0</diffuse>
        </material>
      </visual>

      <!-- Tape strip visual on top -->
      <visual name="tape_strip">
        <pose>0 0 0.351 0 0 0</pose>
        <geometry><box><size>0.50 0.06 0.002</size></box></geometry>
        <material>
          <ambient>0.85 0.75 0.50 1.0</ambient>
          <diffuse>0.92 0.82 0.55 1.0</diffuse>
        </material>
      </visual>

      <!-- Shipping label visual -->
      <visual name="shipping_label">
        <pose>0.251 0.05 0.22 0 0 0</pose>
        <geometry><box><size>0.002 0.14 0.10</size></box></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
        </material>
      </visual>

      <collision name="col_box">
        <pose>0 0 0.175 0 0 0</pose>
        <geometry><box><size>0.50 0.40 0.35</size></box></geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <inertial>
        <mass>8.0</mass>
        <pose>0 0 0.175 0 0 0</pose>
        <inertia>
          <ixx>0.188</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.248</iyy><iyz>0.0</iyz>
          <izz>0.273</izz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
