<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="charging_dock">
    <static>true</static>
    <link name="dock_body">
      <!-- Ground plate base -->
      <visual name="dock_plate">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry><box><size>0.90 0.80 0.03</size></box></geometry>
        <material>
          <ambient>0.20 0.20 0.22 1.0</ambient>
          <diffuse>0.30 0.30 0.32 1.0</diffuse>
        </material>
      </visual>
      <collision name="col_dock_plate">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry><box><size>0.90 0.80 0.03</size></box></geometry>
      </collision>

      <!-- Upright back tower -->
      <visual name="dock_tower">
        <pose>0.40 0 0.40 0 0 0</pose>
        <geometry><box><size>0.15 0.70 0.80</size></box></geometry>
        <material>
          <ambient>0.85 0.45 0.05 1.0</ambient>
          <diffuse>0.95 0.55 0.10 1.0</diffuse>
        </material>
      </visual>
      <collision name="col_dock_tower">
        <pose>0.40 0 0.40 0 0 0</pose>
        <geometry><box><size>0.15 0.70 0.80</size></box></geometry>
      </collision>

      <!-- Charging Contacts / Pad -->
      <visual name="charging_contacts">
        <pose>0.32 0 0.18 0 0 0</pose>
        <geometry><box><size>0.02 0.35 0.12</size></box></geometry>
        <material>
          <ambient>0.80 0.75 0.20 1.0</ambient>
          <diffuse>0.95 0.85 0.25 1.0</diffuse>
        </material>
      </visual>

      <!-- Docking visual target (High contrast chevron for vision sensor) -->
      <visual name="dock_target">
        <pose>0.32 0 0.55 0 0 0</pose>
        <geometry><box><size>0.01 0.40 0.20</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.9 0.9 0.9 1.0</diffuse>
        </material>
      </visual>

      <!-- Status Indicator Light (Green = Available) -->
      <visual name="status_beacon">
        <pose>0.40 0 0.83 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.85 0.25 1.0</ambient>
          <diffuse>0.15 0.95 0.30 1.0</diffuse>
          <emissive>0.10 0.80 0.20 1.0</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
