<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="euro_pallet">
    <static>true</static>
    <link name="pallet_base">
      <!-- Top deck planks -->
      <visual name="top_deck">
        <pose>0 0 0.13 0 0 0</pose>
        <geometry><box><size>1.20 0.80 0.025</size></box></geometry>
        <material>
          <ambient>0.72 0.53 0.35 1.0</ambient>
          <diffuse>0.82 0.60 0.40 1.0</diffuse>
        </material>
      </visual>

      <!-- Center & Side Stringer Blocks (9 blocks) -->
      <visual name="blocks">
        <pose>0 0 0.065 0 0 0</pose>
        <geometry><box><size>1.18 0.78 0.09</size></box></geometry>
        <material>
          <ambient>0.60 0.43 0.28 1.0</ambient>
          <diffuse>0.70 0.50 0.32 1.0</diffuse>
        </material>
      </visual>

      <!-- Bottom deck planks -->
      <visual name="bottom_deck">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry><box><size>1.20 0.80 0.02</size></box></geometry>
        <material>
          <ambient>0.65 0.48 0.30 1.0</ambient>
          <diffuse>0.75 0.55 0.35 1.0</diffuse>
        </material>
      </visual>

      <collision name="col_pallet">
        <pose>0 0 0.072 0 0 0</pose>
        <geometry><box><size>1.20 0.80 0.144</size></box></geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <inertial>
        <mass>22.0</mass>
        <pose>0 0 0.072 0 0 0</pose>
        <inertia>
          <ixx>1.20</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>2.65</iyy><iyz>0.0</iyz>
          <izz>3.80</izz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
